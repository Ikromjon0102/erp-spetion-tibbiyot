[Unit]
Description=Spetion ERP (Django, gunicorn)
After=network.target postgresql.service

[Service]
User=erp
Group=erp
WorkingDirectory=/var/www/erp/app
EnvironmentFile=/var/www/erp/.env
ExecStart=/var/www/erp/venv/bin/gunicorn --workers 3 --threads 2 --timeout 60 --bind 127.0.0.1:8010 config.wsgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
