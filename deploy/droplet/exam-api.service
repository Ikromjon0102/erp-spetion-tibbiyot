[Unit]
Description=Spetion Exam API (FastAPI)
After=network.target postgresql.service

[Service]
User=erp
Group=erp
WorkingDirectory=/var/www/exam/backend
ExecStart=/var/www/exam/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8002 --workers 2
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
